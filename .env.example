# Copy to .env and fill in. Never commit .env.

# ---- LLM provider: openai (default) or ollama (Ollama cloud) ----
LLM_PROVIDER=openai

# ---- Ollama cloud (used when LLM_PROVIDER=ollama). Key: https://ollama.com/settings/keys ----
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash

# ---- LLM (any OpenAI-compatible endpoint) ----
# OpenAI: set LLM_API_KEY, leave LLM_BASE_URL empty.
LLM_API_KEY=sk-...
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Optional cheaper model for plan/evaluate/refine (defaults to LLM_MODEL)
LLM_FAST_MODEL=
# Free local alternative (Ollama): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
# Optional: "none" disables thinking on Ollama thinking models (much faster); empty = model default
LLM_REASONING_EFFORT=
# Set to false if your endpoint rejects response_format=json_object
LLM_JSON_MODE=true

# Evaluation LLM judge (must differ from LLM_MODEL), used only with --judge
JUDGE_MODEL=

# ---- LangSmith tracing (optional). Key: https://smith.langchain.com -> Settings -> API Keys ----
# Traces include document passages sent to the LLM; only enable for documents you are OK sharing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchpilot
# Only for non-US accounts, e.g. https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# ---- Embeddings / reranker (downloaded automatically on first run) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Vector store ----
# Embedded Qdrant, persisted to this folder (no Docker needed)
QDRANT_PATH=data/qdrant
# Or use a Qdrant server instead:
# QDRANT_URL=http://localhost:6333
COLLECTION_NAME=researchpilot

# ---- Ingestion / retrieval / agent ----
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
DROP_REFERENCES=true
TOP_K=5
USE_HYBRID=true
USE_RERANK=false
MAX_CONTEXT_CHUNKS=12
MAX_ROUNDS=3
MAX_QUERIES=3
